  "id": "com.commotbody.nojoinbody",
  "name": "COMMOT BODY NO JOIN BODY",
  "version": "1.0.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "25.0.0", "data": { "apiVersion": 2 } },
  "entrypoints": [{
    "type": "panel",
